{"nbformat":4,"nbformat_minor":0,"metadata":{"colab":{"provenance":[],"authorship_tag":"ABX9TyN3WX5RgvEge4FInQIKxibZ"},"kernelspec":{"name":"python3","display_name":"Python 3"},"language_info":{"name":"python"}},"cells":[{"cell_type":"code","execution_count":null,"metadata":{"id":"nNK6Be6Txpuy","collapsed":true},"outputs":[],"source":["# Installing dependecies\n","!sudo apt install tesseract-ocr -y\n","\n","\n","!pip install pytesseract google-generativeai pydantic opencv-python-headless -q"]},{"cell_type":"code","source":["import cv2\n","import pytesseract\n","import google.generativeai as genai\n","from google.colab import drive\n","from pydantic import BaseModel, Field\n","import json\n","import numpy as np\n","from IPython.display import display\n","from PIL import Image\n","import os\n","\n","\n","drive.mount('/content/drive')\n","\n","\n","\n","api_key = \" Enter your key " \n","genai.configure(api_key=api_key)\n","print(\"gemini API Key configured successfully!\")"],"metadata":{"collapsed":true,"id":"RCk0qlby5NM3"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["# image preprocessing code\n","\n","def extract_text_from_image(image_path):\n","    img = cv2.imread(image_path)\n","    if img is None:\n","        raise ValueError(f\"Could not read image at {image_path}\")\n","\n","    gray = cv2.cvtColor(img, cv2.COLOR_BGR2GRAY)\n","\n","\n","    inverted = cv2.bitwise_not(gray)\n","\n","    thresh = cv2.threshold(inverted, 0, 255, cv2.THRESH_BINARY + cv2.THRESH_OTSU)[1]\n","\n","    custom_config = r'--oem 3 --psm 4'\n","\n","    raw_text = pytesseract.image_to_string(thresh, config=custom_config)\n","\n","    return raw_text.strip()"],"metadata":{"id":"tZWlTM5n8XpO"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["# 1. data structure\n","class RelationshipData(BaseModel):\n","    subject: str = Field(description=\"The primary person being discussed (e.g., Veena Nayar)\")\n","    related_person: str = Field(description=\"The person related to the subject, if any. Use 'None' if NA.\")\n","    relationship_type: str = Field(description=\"How they are related (e.g., Daughter, Son, Daughter-in-law, Grandchild)\")\n","    event: str = Field(description=\"The main event mentioned (e.g., Death, Chautha & Uthala)\")\n","    event_date: str = Field(description=\"Date of the event. Return 'Unknown' if not found.\")\n","    event_venue: str = Field(description=\"The name of the building or venue. Return 'Unknown' if not found.\")\n","    event_address: str = Field(description=\"The street address and city for the event. Return 'Unknown' if not found.\")\n","\n","def extract_structured_data(ocr_text):\n","    # Using the current 3.8 Flash model\n","    model = genai.GenerativeModel('gemini-3.8-flash')\n","\n","    prompt = f\"\"\"\n","    You are an expert information extraction system.\n","    Read the following OCR text from a newspaper clipping.\n","    Extract all listed family members and their exact relationship to the deceased.\n","    Also, extract the venue name and the full address where the scheduled event is taking place.\n","    Fix any obvious OCR typos in the text during your reasoning.\n","\n","    OCR TEXT:\n","    \"{ocr_text}\"\n","    \"\"\"\n","\n","    response = model.generate_content(\n","        prompt,\n","        generation_config=genai.GenerationConfig(\n","            response_mime_type=\"application/json\",\n","            response_schema=list[RelationshipData],\n","        ),\n","    )\n","\n","    return json.loads(response.text)\n","\n","print(\" LLM Extraction function defined!\")"],"metadata":{"id":"cAc-hxyJE2KJ"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["\n","IMAGE_PATH = '/content/drive/MyDrive/Web3/Photo from Rohit'\n","\n","if not os.path.exists(IMAGE_PATH):\n","    print(f\" File not found at {IMAGE_PATH}. Please check the path and try again.\")\n","else:\n","    print(f\"\\n Processing: {IMAGE_PATH}\\n\")\n","\n","\n","    display(Image.open(IMAGE_PATH))\n","\n","\n","\n","    raw_text = extract_text_from_image(IMAGE_PATH)\n","    print(\"Raw OCR Text Extracted:\\n\")\n","\n","    print(raw_text if raw_text else \"[No text detected]\")\n","\n","\n","\n","    if raw_text:\n","        print(\"\\n Running LLM Reasoning & Extraction...\")\n","        structured_data = extract_structured_data(raw_text)\n","\n","        print(\"\\n Final Extracted Information (JSON):\")\n","        print(json.dumps(structured_data, indent=4))\n","    else:\n","        print(\" No text could be extracted from the image. Try a clearer photo.\")"],"metadata":{"collapsed":true,"id":"ms5Zup9N5rNP"},"execution_count":null,"outputs":[]}]}
