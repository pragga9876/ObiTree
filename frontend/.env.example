# URL of the deployed FastAPI backend.
# Development falls back to http://localhost:8000 when this is unset.
# Production builds have no localhost fallback — set this in Vercel.
VITE_API_URL=http://localhost:8000

# Optional: override the Solana RPC used by the browser wallet connection.
# Verification always happens server-side against SOLANA_RPC_URL.
# VITE_SOLANA_RPC_URL=https://api.devnet.solana.com
