# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
# development | production
APP_ENV=development

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Local development falls back to SQLite when DATABASE_URL is unset.
# Production (Render) must point at PostgreSQL, e.g. Supabase:
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=

# ---------------------------------------------------------------------------
# AI extraction
# ---------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# ---------------------------------------------------------------------------
# Solana (Devnet only; no custom program or token)
# ---------------------------------------------------------------------------
SOLANA_NETWORK=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com

# ---------------------------------------------------------------------------
# Supabase Storage (server-side only — never expose these to the frontend)
# ---------------------------------------------------------------------------
# When SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are set, uploads go to
# Supabase Storage. Otherwise they are written to backend/uploads (dev only).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=obituary-images
# "true" for a public bucket, "false" to hand out short-lived signed URLs.
SUPABASE_STORAGE_PUBLIC=true
SUPABASE_SIGNED_URL_TTL=604800

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
# Comma-separated exact origins. Include the production Vercel domain.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173
# Optional regex for preview deployments, e.g. https://.*\.vercel\.app
CORS_ORIGIN_REGEX=
